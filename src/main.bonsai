                                  <ext:Expected>StepperDriversInitialized, Timestamp, Motor0, Motor1, Motor2, Motor3, Motor4, AllZeroed, HarpDelay</ext:Expected>
                                  <ext:TimeoutSeconds>60</ext:TimeoutSeconds>
