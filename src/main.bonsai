<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:ext="clr-namespace:;assembly=Extensions"
                 xmlns:rig="clr-namespace:UclOpenCoenDomeNavigation;assembly=Extensions"
                 xmlns:task="clr-namespace:UclOpenCoenDomeNavigationTask;assembly=Extensions"
                 xmlns:uoc="clr-namespace:OpenRigs.Core;assembly=OpenRigs.Core"
                 xmlns:orcl="clr-namespace:OpenRigs.Control;assembly=OpenRigs.Control"
                 xmlns:hd="clr-namespace:OpenRigs.HarpDevices;assembly=OpenRigs.HarpDevices"
                 xmlns:mf="clr-namespace:OpenRigs.Manifest;assembly=OpenRigs.Manifest"
                 xmlns:lv="clr-namespace:OpenRigs.LiveView;assembly=OpenRigs.LiveView"
                 xmlns:orl="clr-namespace:OpenRigs.Logging;assembly=OpenRigs.Logging"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:scr="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions"
                 xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp"
                 xmlns:step="clr-namespace:Harp.StepperDriver;assembly=Harp.StepperDriver"
                 xmlns:gl="clr-namespace:Bonsai.Shaders;assembly=Bonsai.Shaders"
                 xmlns:res="clr-namespace:Bonsai.Resources;assembly=Bonsai.System"
                 xmlns:beh="clr-namespace:Harp.Behavior;assembly=Harp.Behavior"
                 xmlns:al="clr-namespace:Bonsai.Audio;assembly=Bonsai.Audio"
                 xmlns:dsp="clr-namespace:Bonsai.Dsp;assembly=Bonsai.Dsp"
                 xmlns:mix="clr-namespace:Bonsai.Mixer;assembly=Bonsai.Mixer"
                 xmlns:cvn="clr-namespace:OpenCV.Net;assembly=OpenCV.Net"
                 xmlns:io="clr-namespace:Bonsai.IO;assembly=Bonsai.System"
                 xmlns:num="clr-namespace:Bonsai.Numerics;assembly=Bonsai.Numerics"
                 xmlns:dist="clr-namespace:Bonsai.Numerics.Distributions;assembly=Bonsai.Numerics"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="DisplayDevice" Description="The display the dome projector is on (BonVision CreateWindow); a launch property." />
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>RigSetup</Name>
        <Description>Reads this machine's rig.yml (ReadRigConfig) as av-dome does, the two workflows sharing one rig.yml per rig, takes each device by name (RigDevice), opens the Harp boards, stepper drivers, both Lickety Splits and the cameras, zeroes the spouts, opens BonVision's window and loads the reward lines. The task uses the left Lickety Split and the left valve; the rest are opened and recorded because rig.yml lists them and the manifest expects a folder for each.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="GroupWorkflow">
              <Name>ReadRigConfig</Name>
              <Description>Resolves this machine's rig configuration directory (ConfigRoot\MachineName), publishes it as RigConfigDirectory, and reads rig.yml from it. Fails at startup if either is missing.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="uoc:ResolveRigConfigDirectory">
                      <uoc:ConfigRoot>C:\Coen-Lab-Local\RigConfigs</uoc:ConfigRoot>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:AsyncSubject">
                    <Name>RigConfigDirectory</Name>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Core:ReadRigConfig.bonsai">
                    <FileName>rig.yml</FileName>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="2" To="3" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="rig:DeserializeFromYaml">
              <rig:Type xsi:type="TypeMapping" TypeArguments="rig:UclOpenCoenDomeNavigationRig" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>RigConfigs</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RigConfigs</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>BehaviorBoard</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rig:RigDevice">
                <rig:Name>BehaviorBoard-Main</rig:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>BehaviorBoard-Main</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RigConfigs</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>TimestampGeneratorGen3</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rig:RigDevice">
                <rig:Name>TimestampGeneratorGen3-Main</rig:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>TimestampGeneratorGen3-Main</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RigConfigs</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>StepperDriver</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rig:RigDevice">
                <rig:Name>StepperDriver-A</rig:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>StepperDriver-A</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RigConfigs</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>LicketySplit</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rig:RigDevice">
                <rig:Name>LicketySplit-Left</rig:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>LicketySplit-Left</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RigConfigs</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>LicketySplit</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rig:RigDevice">
                <rig:Name>LicketySplit-Right</rig:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>LicketySplit-Right</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RigConfigs</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Camera</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rig:RigDevice">
                <rig:Name>Camera-Face</rig:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>Camera-Face</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RigConfigs</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Camera</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rig:RigDevice">
                <rig:Name>Camera-Pupil</rig:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>Camera-Pupil</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RigConfigs</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Camera</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rig:RigDevice">
                <rig:Name>Camera-Body</rig:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>Camera-Body</Name>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>HardwareDevices</Name>
              <Description>The Harp devices from rig.yml: timestamp generator (the clock), Behavior board (valves, camera trigger, wheel), the two stepper drivers of the spout stage, and both Lickety Splits; each behind its &lt;Name&gt;.Data and &lt;Name&gt;.Commands subjects.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>TimestampGeneratorGen3-Main</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="PortName" Selector="Settings.PortName" />
                      <Property Name="TimerFrequency" Selector="Settings.TimerFrequency" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:TimestampGeneratorGen3.bonsai">
                    <CommandsSubjectName>TimestampGeneratorCommands</CommandsSubjectName>
                    <PortName>COM16</PortName>
                    <DumpRegisters>true</DumpRegisters>
                    <Heartbeat>Enabled</Heartbeat>
                    <EventsSubjectName>ClockSynchronizerEvents</EventsSubjectName>
                    <TimerFrequency>Timer1000Hz</TimerFrequency>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>ClockSynchronizerEvents</Name>
                  </Expression>
                  <Expression xsi:type="rx:PublishSubject">
                    <Name>TimestampGeneratorGen3-Main.Data</Name>
                  </Expression>
                  <Expression xsi:type="rx:BehaviorSubject" TypeArguments="harp:HarpMessage">
                    <rx:Name>TimestampGeneratorGen3-Main.Commands</rx:Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>TimestampGeneratorGen3-Main.Commands</Name>
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>TimestampGeneratorCommands</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>BehaviorBoard-Main</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="PortName" Selector="Settings.PortName" />
                      <Property Name="CountsPerRev" Selector="Settings.RunningWheel.CountsPerRev" />
                      <Property Name="WheelDiameterMm" Selector="Settings.RunningWheel.WheelDiameterMm" />
                      <Property Name="EnableTrigger0" Selector="Settings.CameraTriggerController.Trigger0Enabled" />
                      <Property Name="EnableTrigger1" Selector="Settings.CameraTriggerController.Trigger1Enabled" />
                      <Property Name="Trigger0Frequency" Selector="Settings.CameraTriggerController.Trigger0Frequency" />
                      <Property Name="Trigger1Frequency" Selector="Settings.CameraTriggerController.Trigger1Frequency" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>BehaviorBoards</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="PortName" />
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:BehaviorBoard.BehaviorBoard.bonsai">
                          <CommandsSubjectName>BehaviorBoard-Main.Commands</CommandsSubjectName>
                          <PortName>COM11</PortName>
                          <DumpRegisters>true</DumpRegisters>
                          <Heartbeat>Enabled</Heartbeat>
                          <EventsSubjectName>BehaviorBoard-Main.Data</EventsSubjectName>
                        </Expression>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="CountsPerRev" />
                          <Property Name="WheelDiameterMm" />
                        </Expression>
                        <Expression xsi:type="GroupWorkflow">
                          <Name>RunningWheel</Name>
                          <Description>OpenRigs.Devices' BehaviorBoard.RunningWheel with the encoder in Position mode, as Tom Childs' workflow and coen-behaviour-box set it: the include sets Displacement and then differences and accumulates, which gives a speed sample, not a distance (audit, 9 Nov 2026). Position mode: AnalogData's Encoder is the absolute count, differenced across its 16-bit wrap and accumulated into the distance in cm at CountsPerRev and WheelDiameterMm (rig.yml), published as BoardWheelDistanceCm.</Description>
                          <Workflow>
                            <Nodes>
                        <Expression xsi:type="beh:CreateMessage">
                          <harp:MessageType>Write</harp:MessageType>
                          <harp:Payload xsi:type="beh:CreateEnableEncodersPayload">
                            <beh:EnableEncoders>EncoderPort2</beh:EnableEncoders>
                          </harp:Payload>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="beh:CreateMessage">
                          <harp:MessageType>Write</harp:MessageType>
                          <harp:Payload xsi:type="beh:CreateEncoderModePayload">
                            <beh:EncoderMode>Position</beh:EncoderMode>
                          </harp:Payload>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="beh:CreateMessage">
                          <harp:MessageType>Write</harp:MessageType>
                          <harp:Payload xsi:type="beh:CreateEncoderResetPayload">
                            <beh:EncoderReset>EncoderPort2</beh:EncoderReset>
                          </harp:Payload>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Concat" />
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>BehaviorBoard-Main.Commands</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>BehaviorBoard-Main.Data</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:SubscribeWhen" />
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>BehaviorBoard-Main.Data</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:DelaySubscription">
                            <rx:DueTime>PT0.1S</rx:DueTime>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="beh:Parse">
                          <harp:Register xsi:type="beh:AnalogData" />
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Encoder</Selector>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="dsp:Difference">
                            <dsp:Order>1</dsp:Order>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="scr:ExpressionTransform">
                          <scr:Name>ConvertSigned</scr:Name>
                          <scr:Expression>it &gt; 32768.0 ? it - 65536.0 : (it &lt; -32768.0 ? it + 65536.0 : it)</scr:Expression>
                        </Expression>
                        <Expression xsi:type="rx:Accumulate" />
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="CountsPerRev" />
                          <Property Name="WheelDiameterMm" />
                        </Expression>
                        <Expression xsi:type="GroupWorkflow">
                          <Name>TicksToCentimeters</Name>
                          <Description>Converts steps on a quadrature encoder to a distance in cm, published to a Subject</Description>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="ExternalizedMapping">
                                <Property Name="Value" DisplayName="CountsPerRev" Description="The number of steps recorded on the quadrature encoder in a full revolution" Category="Running Wheel" />
                              </Expression>
                              <Expression xsi:type="Divide">
                                <Operand xsi:type="WorkflowProperty" TypeArguments="sys:Int16">
                                  <Value>4096</Value>
                                </Operand>
                              </Expression>
                              <Expression xsi:type="ExternalizedMapping">
                                <Property Name="Value" DisplayName="WheelDiameterMm" Description="The diameter of the wheel, in millimetres" Category="Running Wheel" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="IntProperty">
                                  <Value>170</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="scr:ExpressionTransform">
                                <scr:Name>CircumferenceCm</scr:Name>
                                <scr:Expression>(it*Math.Pi)/10</scr:Expression>
                              </Expression>
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="Value" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="Multiply">
                                <Operand xsi:type="FloatProperty">
                                  <Value>53.407074</Value>
                                </Operand>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="2" Label="Source2" />
                              <Edge From="1" To="2" Label="Source3" />
                              <Edge From="2" To="7" Label="Source1" />
                              <Edge From="3" To="4" Label="Source1" />
                              <Edge From="4" To="5" Label="Source1" />
                              <Edge From="5" To="6" Label="Source1" />
                              <Edge From="6" To="7" Label="Source2" />
                              <Edge From="7" To="8" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="rx:PublishSubject">
                          <Name>BoardWheelDistanceCm</Name>
                        </Expression>
                            </Nodes>
                            <Edges>
                          <Edge From="0" To="1" Label="Source1" />
                          <Edge From="1" To="6" Label="Source1" />
                          <Edge From="2" To="3" Label="Source1" />
                          <Edge From="3" To="6" Label="Source2" />
                          <Edge From="4" To="5" Label="Source1" />
                          <Edge From="5" To="6" Label="Source3" />
                          <Edge From="6" To="7" Label="Source1" />
                          <Edge From="7" To="9" Label="Source1" />
                          <Edge From="8" To="9" Label="Source2" />
                          <Edge From="10" To="11" Label="Source1" />
                          <Edge From="11" To="12" Label="Source1" />
                          <Edge From="12" To="13" Label="Source1" />
                          <Edge From="13" To="14" Label="Source1" />
                          <Edge From="14" To="15" Label="Source1" />
                          <Edge From="15" To="16" Label="Source1" />
                          <Edge From="16" To="18" Label="Source1" />
                          <Edge From="17" To="18" Label="Source2" />
                          <Edge From="18" To="19" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="PulseDO1" />
                          <Property Name="PulseDO2" />
                          <Property Name="PulseDO3" />
                          <Property Name="OutputPulseEnable" />
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:BehaviorBoard.PulseController.bonsai">
                          <BehaviorCommandsSubjectName>BehaviorBoard-Main.Commands</BehaviorCommandsSubjectName>
                          <OutputPulseEnable>DO1 DO2 DO3</OutputPulseEnable>
                          <PulseDO1>40</PulseDO1>
                          <PulseDO2>50</PulseDO2>
                          <PulseDO3>3000</PulseDO3>
                          <BehaviorEventsSubjectName>BehaviorBoard-Main.Data</BehaviorEventsSubjectName>
                          <TriggerPulseSubjectName>TriggerPulse</TriggerPulseSubjectName>
                          <TriggerCalibratedPulseSubjectName>TriggerCalibratedPulse</TriggerCalibratedPulseSubjectName>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Tuple(sys:Int32,sys:Double)">
                          <rx:Name>DeliverRewardCommand</rx:Name>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="Extensions\DeliverReward.bonsai" />
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="EnableTrigger0" />
                          <Property Name="EnableTrigger1" />
                          <Property Name="Trigger0Frequency" />
                          <Property Name="Trigger1Frequency" />
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:BehaviorBoard.CameraTriggerController.bonsai">
                          <EnableTrigger0>true</EnableTrigger0>
                          <EnableTrigger1>false</EnableTrigger1>
                          <Trigger0Frequency>50</Trigger0Frequency>
                          <Trigger1Frequency>50</Trigger1Frequency>
                          <BehaviorCommandsSubjectName>BehaviorBoard-Main.Commands</BehaviorCommandsSubjectName>
                          <BehaviorEventsSubjectName>BehaviorBoard-Main.Data</BehaviorEventsSubjectName>
                          <Camera0TriggerEventsSubjectName>Camera0TriggerEvents</Camera0TriggerEventsSubjectName>
                          <Camera1TriggerEventsSubjectName>Camera1TriggerEvents</Camera1TriggerEventsSubjectName>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="BooleanProperty">
                            <Value>true</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Delay">
                            <rx:DueTime>PT2S</rx:DueTime>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>StartCameras</Name>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Int32">
                          <rx:Name>ZapitTriggerClear</rx:Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>ZapitTriggerClear</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="ext:DigitalOutputLine" />
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="OutputClear" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="beh:CreateMessage">
                          <harp:MessageType>Write</harp:MessageType>
                          <harp:Payload xsi:type="beh:CreateOutputClearPayload">
                            <beh:OutputClear>DO3</beh:OutputClear>
                          </harp:Payload>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>BehaviorBoard-Main.Commands</Name>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="4" To="5" Label="Source1" />
                        <Edge From="6" To="7" Label="Source1" />
                        <Edge From="8" To="9" Label="Source1" />
                        <Edge From="10" To="11" Label="Source1" />
                        <Edge From="11" To="12" Label="Source1" />
                        <Edge From="14" To="15" Label="Source1" />
                        <Edge From="15" To="16" Label="Source1" />
                        <Edge From="15" To="17" Label="Source1" />
                        <Edge From="16" To="17" Label="Source2" />
                        <Edge From="17" To="18" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>LicketySplits</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>LicketySplit-Right</Name>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="PortName" Selector="Settings.PortName" />
                            <Property Name="Channel0TriggerThreshold" Selector="Settings.Channel0TriggerThreshold" />
                            <Property Name="Channel0UntriggerThreshold" Selector="Settings.Channel0UntriggerThreshold" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:LicketySplit.bonsai">
                          <CommandsSubjectName>LicketySplit-Right.Commands</CommandsSubjectName>
                          <PortName>COM13</PortName>
                          <DumpRegisters>true</DumpRegisters>
                          <Heartbeat>Enabled</Heartbeat>
                          <EventsSubjectName>LicketySplit-Right.Data</EventsSubjectName>
                          <Channel0TriggerThreshold>0</Channel0TriggerThreshold>
                          <Channel0UntriggerThreshold>0</Channel0UntriggerThreshold>
                          <LickStateSubjectName>LickStateRight</LickStateSubjectName>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>LicketySplit-Left</Name>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="PortName" Selector="Settings.PortName" />
                            <Property Name="Channel0TriggerThreshold" Selector="Settings.Channel0TriggerThreshold" />
                            <Property Name="Channel0UntriggerThreshold" Selector="Settings.Channel0UntriggerThreshold" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:LicketySplit.bonsai">
                          <CommandsSubjectName>LicketySplit-Left.Commands</CommandsSubjectName>
                          <PortName>COM15</PortName>
                          <DumpRegisters>true</DumpRegisters>
                          <Heartbeat>Enabled</Heartbeat>
                          <EventsSubjectName>LicketySplit-Left.Data</EventsSubjectName>
                          <Channel0TriggerThreshold>0</Channel0TriggerThreshold>
                          <Channel0UntriggerThreshold>0</Channel0UntriggerThreshold>
                          <LickStateSubjectName>LickStateLeft</LickStateSubjectName>
                        </Expression>
