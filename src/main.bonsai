                  <Expression xsi:type="GroupWorkflow">
                    <Name>IsEndOfTrack</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="Disable">
                          <Builder xsi:type="SubscribeSubject">
                            <Name>BeepTimer</Name>
                          </Builder>
                        </Expression>
                        <Expression xsi:type="Disable">
                          <Builder xsi:type="rx:Condition">
                            <Name>NoTimeRemaining</Name>
                            <Workflow>
                              <Nodes>
                                <Expression xsi:type="Disable">
                                  <Builder xsi:type="SubscribeSubject">
                                    <Name>BeepTimer</Name>
                                  </Builder>
                                </Expression>
                                <Expression xsi:type="Disable">
                                  <Builder xsi:type="SubscribeSubject">
                                    <Name>MaxTrialTimeSec</Name>
                                  </Builder>
                                </Expression>
                                <Expression xsi:type="Disable">
                                  <Builder xsi:type="Combinator">
                                    <Combinator xsi:type="rx:Zip" />
                                  </Builder>
                                </Expression>
                                <Expression xsi:type="Disable">
                                  <Builder xsi:type="scr:ExpressionTransform">
                                    <scr:Expression>(it.Item1 &gt;= it.Item2)</scr:Expression>
                                  </Builder>
                                </Expression>
                                <Expression xsi:type="Disable">
                                  <Builder xsi:type="WorkflowOutput" />
                                </Expression>
                                <Expression xsi:type="WorkflowInput">
                                  <Name>Source1</Name>
                                </Expression>
                                <Expression xsi:type="SubscribeSubject">
                                  <Name>MaxTrialTimeSec</Name>
                                </Expression>
                                <Expression xsi:type="Combinator">
                                  <Combinator xsi:type="rx:CombineLatest" />
                                </Expression>
                                <Expression xsi:type="scr:ExpressionTransform">
                                  <scr:Expression>(it.Item1 &gt;= it.Item2)</scr:Expression>
                                </Expression>
                                <Expression xsi:type="WorkflowOutput" />
                              </Nodes>
                              <Edges>
                                <Edge From="0" To="2" Label="Source1" />
                                <Edge From="1" To="2" Label="Source2" />
                                <Edge From="2" To="3" Label="Source1" />
                                <Edge From="3" To="4" Label="Source1" />
                                <Edge From="5" To="7" Label="Source1" />
                                <Edge From="6" To="7" Label="Source2" />
                                <Edge From="7" To="8" Label="Source1" />
                                <Edge From="8" To="9" Label="Source1" />
                              </Edges>
                            </Workflow>
                          </Builder>
                        </Expression>
                        <Expression xsi:type="Disable">
                          <Builder xsi:type="Combinator">
                            <Combinator xsi:type="BooleanProperty">
                              <Value>true</Value>
                            </Combinator>
                          </Builder>
                        </Expression>
                        <Expression xsi:type="Disable">
                          <Builder xsi:type="WorkflowOutput" />
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>MouseVirtualPosition</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>TrackLength</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:CombineLatest" />
                        </Expression>
                        <Expression xsi:type="rx:Condition">
                          <Name>TrackEndEnds?</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>StageRow</Name>
                              </Expression>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Sample" />
                              </Expression>
                              <Expression xsi:type="scr:ExpressionTransform">
                                <scr:Name>IsNotStage1or2</scr:Name>
                                <scr:Expression>it.TrackEndEndsTrial</scr:Expression>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="2" Label="Source1" />
                              <Edge From="1" To="2" Label="Source2" />
                              <Edge From="2" To="3" Label="Source1" />
                              <Edge From="3" To="4" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="rx:Condition">
                          <Name>IsEqual</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="scr:ExpressionTransform">
                                <scr:Expression>(it.Item1 == it.Item2)</scr:Expression>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1" />
                              <Edge From="1" To="2" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="BooleanProperty">
                            <Value>true</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>HitEndOfTrack</Name>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="4" To="6" Label="Source1" />
                        <Edge From="5" To="6" Label="Source2" />
                        <Edge From="6" To="7" Label="Source1" />
                        <Edge From="7" To="8" Label="Source1" />
                        <Edge From="8" To="9" Label="Source1" />
                        <Edge From="9" To="10" Label="Source1" />
                        <Edge From="10" To="11" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>Monitor</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="Value" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>IsEndOfTrack</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Materialize" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:CombineLatest" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="io:WriteLine" />
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item2</Selector>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Dematerialize" />
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                        <Edge From="2" To="5" Label="Source1" />
                        <Edge From="3" To="4" Label="Source1" />
                        <Edge From="4" To="5" Label="Source2" />
                        <Edge From="5" To="6" Label="Source1" />
                        <Edge From="6" To="7" Label="Source1" />
                        <Edge From="7" To="8" Label="Source1" />
                        <Edge From="8" To="9" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Merge" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:TakeUntil" />
                  </Expression>
                  <Expression xsi:type="Disable">
                    <Builder xsi:type="MemberSelector">
                      <Selector>Item1</Selector>
                    </Builder>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="StringProperty">
                      <Value>GERION INSERTED FOR TESTING</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>Monitor</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="Value" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>ProcessingTrialEnd</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Materialize" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:CombineLatest" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="io:WriteLine" />
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item2</Selector>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Dematerialize" />
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                        <Edge From="2" To="5" Label="Source1" />
                        <Edge From="3" To="4" Label="Source1" />
                        <Edge From="4" To="5" Label="Source2" />
                        <Edge From="5" To="6" Label="Source1" />
                        <Edge From="6" To="7" Label="Source1" />
                        <Edge From="7" To="8" Label="Source1" />
                        <Edge From="8" To="9" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>ProcessTrialEnd</Name>
                    <Description>Settles the trial once it ends: reward, punishment or neither, then TrialOutcome at once and TrialEnded 2 s later. TrialOutcome is multicast before a Take(1), as TrialEnded is: a MulticastSubject passes on its source's completion, and this stream completes at the end of every trial, which would complete the shared TrialOutcome PublishSubject and stop the trial log after trial 1 (it did: test-1729, 9 Nov 2026). The Take(1) unsubscribes from upstream as the outcome passes, so the completion never reaches it. Keep any multicast to a shared PublishSubject from here before that Take(1). (BehaviorSubjects such as WasRewarded are not completed this way.)</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:TakeLast">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>CurrFreqV</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>CurrFreq</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:CombineLatest" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:WithLatestFrom" />
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item2.Item1</Selector>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>TrialEndFreqV</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item2.Item2</Selector>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>TrialEndFreq</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>RewardFloorFreq</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>RewardCeilFreq</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Zip" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:WithLatestFrom" />
                        </Expression>
                        <Expression xsi:type="scr:ExpressionTransform">
                          <scr:Name>IsOnTarget</scr:Name>
                          <scr:Expression>((it.Item1 &gt;= it.Item2.Item1) &amp;&amp; (it.Item1 &lt;= it.Item2.Item2))</scr:Expression>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>WasOnTarget</Name>
                        </Expression>
                        <Expression xsi:type="rx:Condition">
                          <Name>OnTarget</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="rx:Condition">
                          <Name>NOTTimeoutOrTrackEnd</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>HitEndOfTrack</Name>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>WasTimeout</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:CombineLatest" />
                              </Expression>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Sample" />
                              </Expression>
                              <Expression xsi:type="scr:ExpressionTransform">
                                <scr:Name>IfEitherTrue</scr:Name>
                                <scr:Expression>(it.Item1 || it.Item2)</scr:Expression>
                              </Expression>
                              <Expression xsi:type="BitwiseNot" />
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="2" Label="Source1" />
                              <Edge From="1" To="2" Label="Source2" />
                              <Edge From="2" To="4" Label="Source1" />
                              <Edge From="3" To="4" Label="Source2" />
                              <Edge From="4" To="5" Label="Source1" />
                              <Edge From="5" To="6" Label="Source1" />
                              <Edge From="6" To="7" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="rx:SelectMany">
                          <Name>Reward</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>TaskParams</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>ToneAmplitude</Selector>
                              </Expression>
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="Amplitude" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="dsp:FunctionGenerator">
                                  <dsp:BufferLength>480</dsp:BufferLength>
                                  <dsp:Frequency>6000</dsp:Frequency>
                                  <dsp:Waveform>Sine</dsp:Waveform>
                                  <dsp:SampleRate>48000</dsp:SampleRate>
                                  <dsp:Depth>F32</dsp:Depth>
                                  <dsp:Amplitude>0.05</dsp:Amplitude>
                                  <dsp:Offset>0</dsp:Offset>
                                  <dsp:Phase>0</dsp:Phase>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="RangeMax" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="dsp:Rescale">
                                  <dsp:Min>0</dsp:Min>
                                  <dsp:Max>1</dsp:Max>
                                  <dsp:RangeMin>0</dsp:RangeMin>
                                  <dsp:RangeMax>0.05</dsp:RangeMax>
                                  <dsp:RescaleType>Linear</dsp:RescaleType>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Take">
                                  <rx:Count>25</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="Amplitude" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="dsp:FunctionGenerator">
                                  <dsp:BufferLength>480</dsp:BufferLength>
                                  <dsp:Frequency>9000</dsp:Frequency>
                                  <dsp:Waveform>Sine</dsp:Waveform>
                                  <dsp:SampleRate>48000</dsp:SampleRate>
                                  <dsp:Depth>F32</dsp:Depth>
                                  <dsp:Amplitude>0.5</dsp:Amplitude>
                                  <dsp:Offset>0</dsp:Offset>
                                  <dsp:Phase>0</dsp:Phase>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="RangeMax" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="dsp:Rescale">
                                  <dsp:Min>0</dsp:Min>
                                  <dsp:Max>1</dsp:Max>
                                  <dsp:RangeMin>0</dsp:RangeMin>
                                  <dsp:RangeMax>0.05</dsp:RangeMax>
                                  <dsp:RescaleType>Linear</dsp:RescaleType>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Take">
                                  <rx:Count>25</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Concat" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="dsp:Tile">
                                  <dsp:RowTiles>32</dsp:RowTiles>
                                  <dsp:ColumnTiles>1</dsp:ColumnTiles>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="MulticastSubject">
                                <Name>RewardBuffer</Name>
                              </Expression>
                              <Expression xsi:type="Disable">
                                <Builder xsi:type="Combinator">
                                  <Combinator xsi:type="al:AudioPlayback">
                                    <al:DeviceName>Generic Software on DELL S2722DC (5- HD Audio Driver for Display Audio)</al:DeviceName>
                                    <al:SampleRate>50000</al:SampleRate>
                                    <al:State>Playing</al:State>
                                  </Combinator>
                                </Builder>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:TakeLast">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="BooleanProperty">
                                  <Value>true</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
