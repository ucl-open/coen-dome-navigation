                  <Expression xsi:type="GroupWorkflow">
                    <Name>Zapit</Name>
                    <Description>Connects to the Zapit optogenetics server only when the task YAML enables optogenetics. Commands arrive on ZapitCommands, replies leave on ZapitReplies.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>TaskConfig</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>TaskParameters.Optogenetics.UseZapit</Selector>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:Condition">
                          <Name>OptogeneticsEnabled?</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="rx:SelectMany">
                          <Name>ConnectZapit</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>RigConfigs</Name>
                              </Expression>
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="Host" Selector="Zapit.Host" />
                                  <Property Name="Port" Selector="Zapit.Port" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="IncludeWorkflow" Path="Extensions\Zapit.bonsai">
                                <Host>127.0.0.1</Host>
                                <Port>1488</Port>
                                <ReceiveTimeout>5000</ReceiveTimeout>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                              <Expression xsi:type="SubscribeSubject">
                                <Name>ZapitReplies</Name>
                              </Expression>
                              <Expression xsi:type="rx:Condition">
                                <Name>ZapitError?</Name>
                                <Description>Any error reply from Zapit stops the experiment: a refused StartStimulus (arming or software start), a failed StopStimulus, or a failed query. Carrying on would log trials as stimulated (or stopped) that were not. The StopStimulus sent when the workflow stops is read by ZapitClient itself.</Description>
                                <Workflow>
                                  <Nodes>
                                    <Expression xsi:type="WorkflowInput">
                                      <Name>Source1</Name>
                                    </Expression>
                                    <Expression xsi:type="scr:ExpressionTransform">
                                      <scr:Expression>IsError</scr:Expression>
                                    </Expression>
                                    <Expression xsi:type="WorkflowOutput" />
                                  </Nodes>
                                  <Edges>
                                    <Edge From="0" To="1" Label="Source1" />
                                    <Edge From="1" To="2" Label="Source1" />
                                  </Edges>
                                </Workflow>
                              </Expression>
                              <Expression xsi:type="Format">
                                <Format>Zapit answered {0} with an error (reply value {1}, laserOn {2}). Check the MATLAB window: is the conditions file the task file names (zapitConfigPath) loaded in Zapit, is Zapit calibrated, and is the DAQ working?</Format>
                                <Selector>Command,Value,LaserOn</Selector>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="ext:ThrowError" />
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>ZapitReplies</Name>
                              </Expression>
                              <Expression xsi:type="rx:Condition">
                                <Name>ConditionCountReply?</Name>
                                <Workflow>
                                  <Nodes>
                                    <Expression xsi:type="WorkflowInput">
                                      <Name>Source1</Name>
                                    </Expression>
                                    <Expression xsi:type="scr:ExpressionTransform">
                                      <scr:Expression>CommandCode == 4</scr:Expression>
                                    </Expression>
                                    <Expression xsi:type="WorkflowOutput" />
                                  </Nodes>
                                  <Edges>
                                    <Edge From="0" To="1" Label="Source1" />
                                    <Edge From="1" To="2" Label="Source1" />
                                  </Edges>
                                </Workflow>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Take">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>TaskParams</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Zip" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="ext:CheckZapitConditionCount" />
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>RigConfigs</Name>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>SubjectId</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Zip" />
                              </Expression>
                              <Expression xsi:type="rx:Condition">
                                <Name>SoftwareTriggeredRealMouse?</Name>
                                <Description>A rig without hardware triggering (rig.yml zapit.hardwareTriggered false) starts the laser when the command reaches Zapit, tens of ms late and with no onset in the Harp log. It is only for test mice: an optogenetics experiment with any other mouse stops here.</Description>
                                <Workflow>
                                  <Nodes>
                                    <Expression xsi:type="WorkflowInput">
                                      <Name>Source1</Name>
                                    </Expression>
                                    <Expression xsi:type="scr:ExpressionTransform">
                                      <scr:Expression>!Item1.Zapit.HardwareTriggered &amp;&amp; !Item2.ToLowerInvariant().StartsWith("test")</scr:Expression>
                                    </Expression>
                                    <Expression xsi:type="WorkflowOutput" />
                                  </Nodes>
                                  <Edges>
                                    <Edge From="0" To="1" Label="Source1" />
                                    <Edge From="1" To="2" Label="Source1" />
                                  </Edges>
                                </Workflow>
                              </Expression>
                              <Expression xsi:type="Format">
                                <Format>Optogenetics with a real mouse ({0}) needs a hardware-triggered rig, and this rig's rig.yml has zapit.hardwareTriggered false. Cable the trigger line to the Zapit DAQ trigger input and set hardwareTriggered: true in rig.yml. Rigs without hardware triggering are for test mice only.</Format>
                                <Selector>Item2</Selector>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="ext:ThrowError" />
                              </Expression>
                            </Nodes>
                            <Edges>
                              <Edge From="1" To="2" Label="Source1" />
                              <Edge From="2" To="3" Label="Source1" />
                              <Edge From="3" To="4" Label="Source1" />
                              <Edge From="5" To="6" Label="Source1" />
                              <Edge From="6" To="7" Label="Source1" />
                              <Edge From="7" To="8" Label="Source1" />
                              <Edge From="9" To="10" Label="Source1" />
                              <Edge From="10" To="11" Label="Source1" />
                              <Edge From="11" To="13" Label="Source1" />
                              <Edge From="12" To="13" Label="Source2" />
                              <Edge From="13" To="14" Label="Source1" />
                              <Edge From="15" To="17" Label="Source1" />
                              <Edge From="16" To="17" Label="Source2" />
                              <Edge From="17" To="18" Label="Source1" />
                              <Edge From="18" To="19" Label="Source1" />
                              <Edge From="19" To="20" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="3" To="4" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>BehaviorBoard-Main</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Settings.PulseController.Outputs.DO3</Selector>
                  </Expression>
                  <Expression xsi:type="rig:MatchPulseOutput">
                    <rig:Type xsi:type="TypeMapping" TypeArguments="rig:FixedPulse" />
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="PulseDO3" Selector="PulseWidthMs" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>BehaviorBoard-Main</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Settings.PulseController.OutputPulseEnable</Selector>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RigConfigs</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Zapit.TriggerLine</Selector>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="ext:WithoutPulseLine" />
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="OutputPulseEnable" />
                    </PropertyMappings>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="8" To="9" Label="Source1" />
                  <Edge From="9" To="10" Label="Source1" />
                  <Edge From="15" To="16" Label="Source1" />
                  <Edge From="16" To="17" Label="Source1" />
                  <Edge From="17" To="18" Label="Source1" />
                  <Edge From="18" To="10" Label="Source2" />
                  <Edge From="19" To="20" Label="Source1" />
                  <Edge From="21" To="22" Label="Source1" />
                  <Edge From="20" To="23" Label="Source1" />
                  <Edge From="22" To="23" Label="Source2" />
                  <Edge From="23" To="24" Label="Source1" />
                  <Edge From="24" To="25" Label="Source1" />
                  <Edge From="25" To="10" Label="Source3" />
                  <Edge From="3" To="4" Label="Source1" />
                  <Edge From="6" To="7" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RigConfigs</Name>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="FileName" Selector="ProjectionCalibration.MeshMapPath" />
                <Property Name="GammaLut" Selector="ProjectionCalibration.GammaLutPath" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="DisplayDevice" />
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>BonvisionResources</Name>
              <Description>BonVision's window, mesh mapping and gamma correction for the dome projector, from projectionCalibration in rig.yml; DisplayDevice is a launch property.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="ExternalizedMapping">
                    <Property Name="DisplayDevice" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="gl:CreateWindow">
                      <gl:Width>1920</gl:Width>
                      <gl:Height>1080</gl:Height>
                      <gl:VSync>On</gl:VSync>
                      <gl:SwapSync>false</gl:SwapSync>
                      <gl:ClearColor>Gray</gl:ClearColor>
                      <gl:ClearMask>DepthBufferBit ColorBufferBit</gl:ClearMask>
                      <gl:CursorVisible>false</gl:CursorVisible>
                      <gl:Location xsi:nil="true" />
                      <gl:WindowBorder>Fixed</gl:WindowBorder>
                      <gl:WindowState>Fullscreen</gl:WindowState>
                      <gl:DisplayDevice>First</gl:DisplayDevice>
                      <gl:TargetRenderFrequency>60</gl:TargetRenderFrequency>
                      <gl:TargetUpdateFrequency>60</gl:TargetUpdateFrequency>
                      <gl:RenderState />
                      <gl:GraphicsMode>
                        <gl:ColorFormat>
                          <gl:Red>8</gl:Red>
                          <gl:Green>8</gl:Green>
                          <gl:Blue>8</gl:Blue>
                          <gl:Alpha>8</gl:Alpha>
                        </gl:ColorFormat>
                        <gl:Depth>16</gl:Depth>
                        <gl:Stencil>0</gl:Stencil>
                        <gl:Samples>0</gl:Samples>
                        <gl:AccumulatorFormat>
                          <gl:Red>0</gl:Red>
                          <gl:Green>0</gl:Green>
                          <gl:Blue>0</gl:Blue>
                          <gl:Alpha>0</gl:Alpha>
                        </gl:AccumulatorFormat>
                        <gl:Buffers>2</gl:Buffers>
                        <gl:Stereo>false</gl:Stereo>
                      </gl:GraphicsMode>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="BonVision:Primitives.BonVisionResources.bonsai" />
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="res:LoadResources" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="gl:RenderFrame" />
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="BonVision:Environment.OrthographicView.bonsai">
                    <Left>-135</Left>
                    <Right>135</Right>
                    <Bottom>-22.5</Bottom>
                    <Top>82.5</Top>
                  </Expression>
                  <Expression xsi:type="rx:BehaviorSubject">
                    <Name>DrawStimuli</Name>
                  </Expression>
                  <Expression xsi:type="ExternalizedMapping">
                    <Property Name="FileName" />
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="BonVision:Environment.MeshMapping.bonsai">
                    <ClearColor>Gray</ClearColor>
                    <FileName>C:\RigConfigs\MeshMap.csv</FileName>
                  </Expression>
                  <Expression xsi:type="ExternalizedMapping">
                    <Property Name="GammaLut" />
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="BonVision:Environment.GammaCorrection.bonsai">
                    <ClearColor>Gray</ClearColor>
                    <GammaLut>C:\RigConfigs\gammalut.bmp</GammaLut>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="2" To="3" Label="Source1" />
                  <Edge From="4" To="5" Label="Source1" />
                  <Edge From="5" To="6" Label="Source1" />
                  <Edge From="6" To="8" Label="Source1" />
                  <Edge From="7" To="8" Label="Source2" />
                  <Edge From="8" To="10" Label="Source1" />
                  <Edge From="9" To="10" Label="Source2" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="ext:DisposeOnRenderThread">
                <ext:TimeoutSeconds>2</ext:TimeoutSeconds>
              </Combinator>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>RewardLines</Name>
              <Description>Builds the left and right reward lines from the rig configuration: rewardValves says which behavior board line each side is, and that line's entry in the outputs is loaded. A calibrated line reads and fits its valve calibration from the rig configuration directory, a fixed line keeps its width. The Logging group snapshots each calibration read into the experiment folder.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RigConfigs</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RigConfigDirectory</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="ext:LoadSideRewardLine">
                      <ext:Side>Left</ext:Side>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Take">
                      <rx:Count>1</rx:Count>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:AsyncSubject">
                    <Name>RewardLineLeft</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RigConfigs</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RigConfigDirectory</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="ext:LoadSideRewardLine">
                      <ext:Side>Right</ext:Side>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Take">
                      <rx:Count>1</rx:Count>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:AsyncSubject">
                    <Name>RewardLineRight</Name>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="0" To="2" Label="Source1" />
                  <Edge From="1" To="2" Label="Source2" />
                  <Edge From="2" To="3" Label="Source1" />
                  <Edge From="3" To="4" Label="Source1" />
                  <Edge From="4" To="5" Label="Source1" />
                  <Edge From="6" To="8" Label="Source1" />
                  <Edge From="7" To="8" Label="Source2" />
                  <Edge From="8" To="9" Label="Source1" />
                  <Edge From="9" To="10" Label="Source1" />
                  <Edge From="10" To="11" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RigConfigs</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>StepperDriver</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rig:RigDevice">
                <rig:Name>StepperDriver-B</rig:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>StepperDriver-B</Name>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="8" To="9" Label="Source1" />
            <Edge From="9" To="10" Label="Source1" />
            <Edge From="10" To="11" Label="Source1" />
            <Edge From="12" To="13" Label="Source1" />
            <Edge From="13" To="14" Label="Source1" />
            <Edge From="14" To="15" Label="Source1" />
            <Edge From="16" To="17" Label="Source1" />
            <Edge From="17" To="18" Label="Source1" />
            <Edge From="18" To="19" Label="Source1" />
            <Edge From="20" To="21" Label="Source1" />
            <Edge From="21" To="22" Label="Source1" />
            <Edge From="22" To="23" Label="Source1" />
            <Edge From="24" To="25" Label="Source1" />
            <Edge From="25" To="26" Label="Source1" />
            <Edge From="26" To="27" Label="Source1" />
            <Edge From="28" To="29" Label="Source1" />
            <Edge From="29" To="30" Label="Source1" />
            <Edge From="30" To="31" Label="Source1" />
            <Edge From="32" To="33" Label="Source1" />
            <Edge From="33" To="34" Label="Source1" />
            <Edge From="34" To="35" Label="Source1" />
            <Edge From="37" To="38" Label="Source1" />
            <Edge From="38" To="40" Label="Source1" />
            <Edge From="39" To="40" Label="Source2" />
            <Edge From="40" To="41" Label="Source1" />
            <Edge From="43" To="44" Label="Source1" />
            <Edge From="44" To="45" Label="Source1" />
            <Edge From="45" To="46" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Declarations</Name>
        <Description>Typed subjects shared across groups: whether the spouts are zeroed, the Zapit command and reply streams, and TrialOutcome (true once a trial's outcome, rewarded or not, is known: TrialRow builds the row then, so a Stop during the 2 s before TrialEnded does not lose it).</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Boolean">
              <rx:Name>SteppersZEROed</rx:Name>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject" TypeArguments="ext:ZapitCommand">
              <rx:Name>ZapitCommands</rx:Name>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject" TypeArguments="ext:ZapitReply">
              <rx:Name>ZapitReplies</rx:Name>
            </Expression>
            <Expression xsi:type="rx:PublishSubject" TypeArguments="sys:Boolean">
              <rx:Name>TrialOutcome</rx:Name>
            </Expression>
          </Nodes>
          <Edges />
        </Workflow>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="SubjectId" Description="The mouse; the launch's own, from rig-control." />
        <Property Name="SessionId" Description="The session number; the launch's own, from rig-control." />
        <Property Name="TaskPath" Description="The task file read at Go: rig-control's copy of the one chosen at launch, with the form's edits (lib-open-rigs settings-files plan); from the editor, config\task-abstract-av-corridor.yml." />
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Initialization</Name>
        <Description>The experiment controller (OpenRigs.Control, ExperimentControl), as av-dome's: SubjectId and SessionId from the launch, ManualRewardUl and StepSize settable until Go and the spout commands at any time; at Go RunSettings (subject, session) and TaskFilePath (TaskPath, the task file rig-control wrote) are published and StartExperiment turns true; Ready is reported once the spouts are zeroed.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Value" DisplayName="SubjectId" Description="The subject (mouse) ID." />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="StringProperty">
                <Value></Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>SubjectId</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="SessionId" />
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>SubjectId</Name>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="SubjectId" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Control:ExperimentControl.bonsai">
              <SubjectId>UNMAPPED</SubjectId>
              <SessionId />
              <ControlEndpoint>@tcp://127.0.0.1:5561</ControlEndpoint>
              <Parameters>
                <Parameter>
                  <Name>TrainingStage</Name>
                  <Value>0</Value>
                  <Description>Row of the task file's trainingStages to run, 0 to 5 (Tom Childs' stages 1 to 6; a row past the end uses the last): suggested from the mouse's earlier experiments of the modality.</Description>
                  <Minimum>0</Minimum>
                  <Maximum>5</Maximum>
                  <WholeNumber>true</WholeNumber>
                </Parameter>
                <Parameter>
                  <Name>ManualRewardUl</Name>
                  <Value>3</Value>
                  <Description>Microlitres RewardLeft and RewardRight deliver before Go, taken live; after Go too. The task's own rewards are this stage's rewardSizeUl (trainingStages).</Description>
                  <Minimum>0</Minimum>
                </Parameter>
                <Parameter>
                  <Name>SpoutStepSize</Name>
                  <Value>150</Value>
                  <Description>Motor steps each spout nudge command moves, taken live while ready.</Description>
                  <Minimum>1</Minimum>
                  <WholeNumber>true</WholeNumber>
                </Parameter>
              </Parameters>
              <Commands>
                <Command>
                  <Name>RewardLeft</Name>
                  <Description>Deliver one reward on the left spout (flush).</Description>
                </Command>
                <Command>
                  <Name>RewardRight</Name>
                  <Description>Deliver one reward on the right spout (flush).</Description>
                </Command>
                <Command>
                  <Name>SpoutsHome</Name>
                  <Description>Move both spouts to the home position.</Description>
                </Command>
                <Command>
                  <Name>SpoutsIn</Name>
                  <Description>Move both spouts to the in position.</Description>
                </Command>
                <Command>
                  <Name>SpoutsOut</Name>
                  <Description>Move both spouts to the out position.</Description>
                </Command>
                <Command>
                  <Name>SaveSpoutPositions</Name>
                  <Description>Save the spouts' in positions to this mouse's file.</Description>
                </Command>
                <Command>
                  <Name>LeftUp</Name>
                  <Description>Nudge the left spout up by SpoutStepSize.</Description>
                </Command>
                <Command>
                  <Name>LeftDown</Name>
                  <Description>Nudge the left spout down by SpoutStepSize.</Description>
                </Command>
                <Command>
                  <Name>RightUp</Name>
                  <Description>Nudge the right spout up by SpoutStepSize.</Description>
                </Command>
                <Command>
                  <Name>RightDown</Name>
                  <Description>Nudge the right spout down by SpoutStepSize.</Description>
                </Command>
                <Command>
                  <Name>LeftFront</Name>
                  <Description>Nudge the left spout forward by SpoutStepSize.</Description>
                </Command>
                <Command>
                  <Name>LeftBack</Name>
                  <Description>Nudge the left spout back by SpoutStepSize.</Description>
                </Command>
                <Command>
                  <Name>RightFront</Name>
                  <Description>Nudge the right spout forward by SpoutStepSize.</Description>
                </Command>
                <Command>
                  <Name>RightBack</Name>
                  <Description>Nudge the right spout back by SpoutStepSize.</Description>
                </Command>
                <Command>
                  <Name>BaseLeft</Name>
                  <Description>Nudge the spout base left by SpoutStepSize.</Description>
                </Command>
                <Command>
                  <Name>BaseRight</Name>
                  <Description>Nudge the spout base right by SpoutStepSize.</Description>
                </Command>
              </Commands>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>SubjectId</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:SubscribeWhen" />
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ExperimentGo</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>SubjectId</Selector>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ExperimentGo</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>SessionId</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:Condition">
              <Name>RunSettingsValid</Name>
              <Description>Subject and session given.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="scr:ExpressionTransform">
                    <scr:Expression>Item1.Trim().Length &gt; 0 &amp;&amp; Item2.Trim().Length &gt; 0</scr:Expression>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:First" />
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>RunSettings</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ExperimentGo</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="StringProperty">
                <Value>..\config\task-abstract-av-corridor.yml</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>TaskFilePath</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="BooleanProperty">
                <Value>false</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject">
              <Name>StartExperiment</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ExperimentGo</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="BooleanProperty">
                <Value>true</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>StartExperiment</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="IntProperty">
                <Value>150</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject">
              <Name>StepperStepSize</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ControlEvents</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnParameterSet">
                <orcl:Name>SpoutStepSize</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Name>StepSizeToInt</scr:Name>
              <scr:Expression>Convert.ToInt32(it)</scr:Expression>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>StepperStepSize</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="DoubleProperty">
                <Value>3</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject">
              <Name>RewardUl</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ControlEvents</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnParameterSet">
                <orcl:Name>ManualRewardUl</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:Condition">
              <Name>Given?</Name>
              <Description>A blank set keeps the size as it was.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="scr:ExpressionTransform">
                    <scr:Expression>it.Trim().Length &gt; 0</scr:Expression>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Name>RewardToDouble</scr:Name>
              <scr:Expression>Convert.ToDouble(it)</scr:Expression>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>RewardUl</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>SteppersZEROed</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:ReportPhase">
                <orcl:Phase>Ready</orcl:Phase>
              </Combinator>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Value" DisplayName="TaskPath" Description="The task file read at Go: rig-control's copy of the one chosen at launch, with the form's edits; from the editor, config\task-abstract-av-corridor.yml." />
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="4" To="7" Label="Source1" />
            <Edge From="6" To="7" Label="Source2" />
            <Edge From="7" To="9" Label="Source1" />
            <Edge From="8" To="9" Label="Source2" />
            <Edge From="10" To="11" Label="Source1" />
            <Edge From="12" To="13" Label="Source1" />
            <Edge From="11" To="14" Label="Source1" />
            <Edge From="13" To="14" Label="Source2" />
            <Edge From="14" To="15" Label="Source1" />
            <Edge From="15" To="16" Label="Source1" />
            <Edge From="16" To="17" Label="Source1" />
            <Edge From="17" To="18" Label="Source1" />
            <Edge From="19" To="20" Label="Source1" />
            <Edge From="20" To="21" Label="Source1" />
            <Edge From="21" To="22" Label="Source1" />
            <Edge From="23" To="24" Label="Source1" />
            <Edge From="25" To="26" Label="Source1" />
            <Edge From="26" To="27" Label="Source1" />
            <Edge From="28" To="29" Label="Source1" />
            <Edge From="30" To="31" Label="Source1" />
            <Edge From="31" To="32" Label="Source1" />
            <Edge From="32" To="33" Label="Source1" />
            <Edge From="34" To="35" Label="Source1" />
            <Edge From="36" To="37" Label="Source1" />
            <Edge From="37" To="38" Label="Source1" />
            <Edge From="38" To="39" Label="Source1" />
            <Edge From="39" To="40" Label="Source1" />
            <Edge From="41" To="42" Label="Source1" />
            <Edge From="42" To="43" Label="Source1" />
            <Edge From="44" To="20" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Task</Name>
        <Description>At Go: reads the task file (TaskPath, rig-control's copy of config\task-abstract-av-corridor.yml with the form's edits; from the editor config\task-abstract-av-corridor.yml), publishes it as TaskConfig and its taskParameters as TaskParams once CheckWaveforms has found src\waveforms made for its sweep, and from them Modality, which stimuli are active, TrainingStage (the experiment setting, at Go) with StageRow (that row of trainingStages: what the stage does) and TaskRandom (every draw, from rngSeed). InitVars declares the task's state and loads the tones and error tone. Tom Childs' Params, read from session-schemas before.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="SubscribeSubject">
              <Name>TaskFilePath</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rig:ReadTextFile" />
            </Expression>
            <Expression xsi:type="task:DeserializeFromYaml">
              <task:Type xsi:type="TypeMapping" TypeArguments="task:UclOpenCoenDomeNavigationTaskLogic" />
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>TaskConfig</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>TaskConfig</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>TaskParameters</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="ext:CheckWaveforms">
                <ext:FileName>waveforms\sweep.txt</ext:FileName>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>TaskParams</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>TaskParams</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Modality</Selector>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject">
              <Name>Modality</Name>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>InitVars</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>VisParams</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>TaskParams</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>SweepStartHz</Selector>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>SweepEndHz</Selector>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Zip" />
                        </Expression>
                        <Expression xsi:type="scr:ExpressionTransform">
                          <scr:Name>Start-End-Multiple</scr:Name>
                          <scr:Expression>it.item2/it.Item1</scr:Expression>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>StartFreqV</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>EndFreqV</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Zip" />
                        </Expression>
                        <Expression xsi:type="scr:ExpressionTransform">
                          <scr:Name>Start-End-Multiple</scr:Name>
                          <scr:Expression>it.item2/it.Item1</scr:Expression>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Zip" />
                        </Expression>
                        <Expression xsi:type="scr:ExpressionTransform">
                          <scr:Name>Aud-Over-Vis-Multiple</scr:Name>
                          <scr:Expression>it.item1/it.Item2</scr:Expression>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>VisToAudMultiple</Name>
                        </Expression>
                        <Expression xsi:type="Disable">
                          <Builder xsi:type="SubscribeSubject">
                            <Name>DrawStimuli</Name>
                          </Builder>
                        </Expression>
                        <Expression xsi:type="Disable">
                          <Builder xsi:type="IncludeWorkflow" Path="BonVision:Primitives.DrawQuad.bonsai">
                            <ExtentX>10</ExtentX>
                            <ExtentY>10</ExtentY>
                            <LocationX>0</LocationX>
                            <LocationY>0</LocationY>
                            <Layer>0</Layer>
                            <Angle>90</Angle>
                            <ColorR>0.5</ColorR>
                            <ColorG>0.5</ColorG>
                            <ColorB>0.5</ColorB>
                            <ColorA>1</ColorA>
                          </Builder>
                        </Expression>
                        <Expression xsi:type="Disable">
                          <Builder xsi:type="SubscribeSubject">
                            <Name>DrawStimuli</Name>
                          </Builder>
                        </Expression>
                        <Expression xsi:type="Disable">
                          <Builder xsi:type="IncludeWorkflow" Path="BonVision:Primitives.DrawGratings.bonsai">
                            <LocationX>0</LocationX>
                            <LocationY>10</LocationY>
                            <Layer>0</Layer>
                            <ExtentX>180</ExtentX>
                            <ExtentY>60</ExtentY>
                            <SpatialFrequency>0.06</SpatialFrequency>
                            <TemporalFrequency>0</TemporalFrequency>
                            <Phase>0</Phase>
                            <Angle>90</Angle>
                            <SquareWave>false</SquareWave>
                            <Contrast>1</Contrast>
                            <DutyCycle xsi:nil="true" />
                            <Radius>100</Radius>
                            <Aperture>0</Aperture>
                            <Opacity>1</Opacity>
                          </Builder>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="DoubleProperty">
                            <Value>0.03</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>StartFreqV</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="DoubleProperty">
                            <Value>0.3</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>EndFreqV</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="DoubleProperty">
                            <Value>0</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>CurrPhase</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="DoubleProperty">
                            <Value>0</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>CurrFreqV</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="DoubleProperty">
                            <Value>1</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>Opacity</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="DoubleProperty">
                            <Value>1</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>CurrOpacity</Name>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="0" To="2" Label="Source1" />
                        <Edge From="1" To="3" Label="Source1" />
                        <Edge From="2" To="3" Label="Source2" />
                        <Edge From="3" To="4" Label="Source1" />
                        <Edge From="4" To="9" Label="Source1" />
                        <Edge From="5" To="7" Label="Source1" />
                        <Edge From="6" To="7" Label="Source2" />
                        <Edge From="7" To="8" Label="Source1" />
                        <Edge From="8" To="9" Label="Source2" />
                        <Edge From="9" To="10" Label="Source1" />
                        <Edge From="10" To="11" Label="Source1" />
                        <Edge From="12" To="13" Label="Source1" />
                        <Edge From="14" To="15" Label="Source1" />
                        <Edge From="16" To="17" Label="Source1" />
                        <Edge From="18" To="19" Label="Source1" />
                        <Edge From="20" To="21" Label="Source1" />
                        <Edge From="22" To="23" Label="Source1" />
                        <Edge From="24" To="25" Label="Source1" />
                        <Edge From="26" To="27" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>InitVars</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:TimeSpan">
                          <rx:Name>InterTrialInterval</rx:Name>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Double">
                          <rx:Name>AudAmplitude</rx:Name>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Int64">
                          <rx:Name>BeepTimer</rx:Name>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Double">
                          <rx:Name>TrackLength</rx:Name>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Double">
                          <rx:Name>RewardFloorFreq</rx:Name>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Double">
                          <rx:Name>RewardCeilFreq</rx:Name>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Double">
                          <rx:Name>RewardFloorVirtualPos</rx:Name>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Double">
                          <rx:Name>RewardCeilVirtualPos</rx:Name>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Double">
                          <rx:Name>TrialEndFreq</rx:Name>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Double">
                          <rx:Name>TrialEndFreqV</rx:Name>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Boolean">
                          <rx:Name>TrialEnded</rx:Name>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="cvn:Mat">
                          <rx:Name>Buffer</rx:Name>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="cvn:Mat">
                          <rx:Name>RewardBuffer</rx:Name>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="cvn:Mat">
                          <rx:Name>ErrorBuffer</rx:Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>TaskParams</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>ToneAmplitude</Selector>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Text><![CDATA[Rescales Amplitude to 1 or 0 Depending on if AudioStimActive is True or False]]></Text>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>AudioStimActive</Name>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="Value" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="Multiply">
                          <Operand xsi:type="DoubleProperty">
                            <Value>1</Value>
                          </Operand>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>AudAmplitude</Name>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="RangeMax" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="dsp:MatrixReader">
                            <dsp:Path>./waveforms/all_waveforms.bin</dsp:Path>
                            <dsp:Offset>0</dsp:Offset>
                            <dsp:SampleRate>48000</dsp:SampleRate>
                            <dsp:ChannelCount>1</dsp:ChannelCount>
                            <dsp:BufferLength>2400</dsp:BufferLength>
                            <dsp:Depth>F32</dsp:Depth>
                            <dsp:Layout>RowMajor</dsp:Layout>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="dsp:Rescale">
                            <dsp:Min>0</dsp:Min>
                            <dsp:Max>1</dsp:Max>
                            <dsp:RangeMin>0</dsp:RangeMin>
                            <dsp:RangeMax>0.05</dsp:RangeMax>
                            <dsp:RescaleType>Linear</dsp:RescaleType>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>SweepSteps</Selector>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="Count" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>100</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="dsp:Tile">
                            <dsp:RowTiles>32</dsp:RowTiles>
                            <dsp:ColumnTiles>1</dsp:ColumnTiles>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:ToList" />
                        </Expression>
                        <Expression xsi:type="rx:AsyncSubject">
                          <Name>WaveformDict</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="IntProperty">
                            <Value>0</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>LickCount</Name>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>TrialNumber</Name>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>CurrFreq</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="BooleanProperty">
                            <Value>false</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>WasRewarded</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="BooleanProperty">
                            <Value>false</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>WasTimeout</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="BooleanProperty">
                            <Value>false</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>HitEndOfTrack</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>TaskParams</Name>
                        </Expression>
                        <Expression xsi:type="scr:ExpressionTransform">
                          <scr:Name>TimeLimit</scr:Name>
                          <scr:Expression>TimeSpan.FromSeconds(it.TrialStructure.TimeLimitSeconds)</scr:Expression>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>MaxTrialTimeSec</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="DoubleProperty">
                            <Value>0</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>StartTime</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="DoubleProperty">
                            <Value>0</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>TrialStartWheelDistance</Name>
                        </Expression>
                        <Expression xsi:type="Disable">
                          <Builder xsi:type="Combinator">
                            <Combinator xsi:type="DoubleProperty">
                              <Value>0</Value>
                            </Combinator>
                          </Builder>
                        </Expression>
                        <Expression xsi:type="Disable">
                          <Builder xsi:type="rx:BehaviorSubject">
                            <Name>CurrAmp</Name>
                          </Builder>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="DoubleProperty">
                            <Value>500</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>DriftBeepsTillEnd</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="DoubleProperty">
                            <Value>0</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>TrialDistFloor</Name>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Double">
                          <rx:Name>TrialActive</rx:Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="DoubleProperty">
                            <Value>1</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>TruncationPoint</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="DoubleProperty">
                            <Value>1</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>StimulusActive</Name>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Int32">
                          <rx:Name>AudBin</rx:Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>ErrorTone loaded once</Name>
                          <Text><![CDATA[Read into memory once, at Go (punishment.sound.path in the task file), instead of from disk on every punishment, so the relative path cannot fail mid-session if the working directory changes and crash the workflow on an error trial.]]></Text>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="al:AudioReader">
                            <al:FileName>waveforms\error_tone.wav</al:FileName>
                            <al:BufferLength>0</al:BufferLength>
                            <al:SampleRate>0</al:SampleRate>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:AsyncSubject">
                          <Name>ErrorTone</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Optogenetics</Name>
                          <Text><![CDATA[Zapit optogenetics, as in av-dome. ZapitCommands go to the Zapit include in Devices, which answers on ZapitReplies. OptoTrial holds the stimulation drawn for the current trial, set at ITI start in TaskLogic.]]></Text>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="ext:OptoTrial">
                          <rx:Name>OptoTrial</rx:Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>TaskParams</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Punishment.Sound.Path</Selector>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="FileName" />
                          </PropertyMappings>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="14" To="15" Label="Source1" />
                        <Edge From="14" To="24" Label="Source1" />
                        <Edge From="15" To="19" Label="Source1" />
                        <Edge From="16" To="17" Label="Source1" />
                        <Edge From="17" To="18" Label="Source1" />
                        <Edge From="18" To="19" Label="Source2" />
                        <Edge From="19" To="20" Label="Source1" />
