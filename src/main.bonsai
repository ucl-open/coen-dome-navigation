      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Commands</Name>
        <Description>The controller's commands, while ready or recording: rewards (flushes) on either spout, the spouts home, in and out, nudging each spout and the base by SpoutStepSize, and saving this mouse's spout positions. The valve and stepper logic is the old GUI's; only its sources changed, from buttons to OnCommand.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="Annotation">
              <Name>Commands</Name>
              <Text><![CDATA[Each command the controller may send (declared on ExperimentControl) raises the subject the valve and stepper logic below already listens to. Spout nudges pair as the GUI's buttons did: Left/Right Up/Down are motors 4/5, Left/Right Front/Back motors 2/3, Base Left/Right motor 1.]]></Text>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ControlEvents</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>RewardLeft</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>RewardLeft</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>RewardRight</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>RewardRight</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>SpoutsHome</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>SpoutsHome</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>SpoutsIn</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>SpoutsIn</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>SpoutsOut</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>SpoutsOut</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>SaveSpoutPositions</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>SaveSpoutPositions</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>LeftUp</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor4_UP</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>LeftDown</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor4_DOWN</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>RightUp</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor5_UP</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>RightDown</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor5_DOWN</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>LeftFront</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor2_UP</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>LeftBack</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor2_DOWN</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>RightFront</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor3_UP</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>RightBack</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor3_DOWN</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>BaseLeft</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor1_UP</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>BaseRight</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor1_DOWN</Name>
            </Expression>
            <Expression xsi:type="Annotation">
              <Name>Spout positions file</Name>
              <Text><![CDATA[This mouse's spout positions: <RigConfigDirectory>\calibration\LickSpoutPositions\<SubjectId>.csv, written by SaveSpoutPositions and read at Start (ReadPositions); a mouse without one gets rig.yml's lickSpoutDefaultPosition. Tom's mice's files were copied there from C:\RigConfigs\LickSpoutPositions, where auditory-vr-corridor keeps them, on BLUE-OPTO-2 on 9 Nov 2026 (BACKLOG); copy them on each other corridor rig before it runs a mouse of Tom's.]]></Text>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RigConfigDirectory</Name>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>it + "\\calibration\\LickSpoutPositions\\"</scr:Expression>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>SubjectId</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>it.Item1 + it.Item2 + ".csv"</scr:Expression>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject">
              <Name>SpoutPositionFileName</Name>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>ValveCommands</Name>
              <Description>ValveGUICallbacks</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RewardLeft</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="IntProperty">
                      <Value>1</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RewardRight</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="IntProperty">
                      <Value>2</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Merge" />
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RewardUl</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:WithLatestFrom" />
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>DeliverRewardCommand</Name>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="2" To="3" Label="Source1" />
                  <Edge From="1" To="4" Label="Source1" />
                  <Edge From="3" To="4" Label="Source2" />
                  <Edge From="4" To="6" Label="Source1" />
                  <Edge From="5" To="6" Label="Source2" />
                  <Edge From="6" To="7" Label="Source1" />
                  <Edge From="7" To="8" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>StepperCommands</Name>
              <Description>StepperMotorGUICallbacks</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="Annotation">
                    <Name>Update Motor IN position data</Name>
                    <Text><![CDATA[Update Motor IN position data]]></Text>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>Position Update</Name>
                    <Description>Position Update</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="Annotation">
                          <Name>Motor1_IN_position</Name>
                          <Text><![CDATA[Motor1_IN_position]]></Text>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Motor1_Position</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Motor2_IN_position</Name>
                          <Text><![CDATA[Motor2_IN_position]]></Text>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Motor2_Position</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Motor3_IN_position</Name>
                          <Text><![CDATA[Motor3_IN_position]]></Text>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Motor3_Position</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Motor4_IN_position</Name>
                          <Text><![CDATA[Motor4_IN_position]]></Text>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Motor4_Position</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Motor5_IN_position</Name>
                          <Text><![CDATA[Motor5_IN_position]]></Text>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Motor5_Position</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Grab all latest inputs</Name>
                          <Text><![CDATA[Grab all latest inputs]]></Text>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:CombineLatest" />
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Store IN position</Name>
                          <Text><![CDATA[Store IN position]]></Text>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>StepperPosition_BothIn</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>StepperPosition_BothIn</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Sends command with every update</Name>
                          <Text><![CDATA[Sends command with every update]]></Text>
                        </Expression>
                        <Expression xsi:type="rx:SelectMany">
                          <Name>Send command when experiment not running</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>StartExperiment</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:WithLatestFrom" />
                              </Expression>
                              <Expression xsi:type="rx:Condition">
                                <Name>Send Command?</Name>
                                <Workflow>
                                  <Nodes>
                                    <Expression xsi:type="WorkflowInput">
                                      <Name>Source1</Name>
                                    </Expression>
                                    <Expression xsi:type="MemberSelector">
                                      <Selector>Item2</Selector>
                                    </Expression>
                                    <Expression xsi:type="BitwiseNot" />
                                    <Expression xsi:type="WorkflowOutput" />
                                  </Nodes>
                                  <Edges>
                                    <Edge From="0" To="1" Label="Source1" />
                                    <Edge From="1" To="2" Label="Source1" />
                                    <Edge From="2" To="3" Label="Source1" />
                                  </Edges>
                                </Workflow>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="MulticastSubject">
                                <Name>StepperPositionCommand</Name>
                              </Expression>
                              <Expression xsi:type="rx:Condition">
                                <Name>Don't send?</Name>
                                <Workflow>
                                  <Nodes>
                                    <Expression xsi:type="WorkflowInput">
                                      <Name>Source1</Name>
                                    </Expression>
                                    <Expression xsi:type="MemberSelector">
                                      <Selector>Item2</Selector>
                                    </Expression>
                                    <Expression xsi:type="WorkflowOutput" />
                                  </Nodes>
                                  <Edges>
                                    <Edge From="0" To="1" Label="Source1" />
                                    <Edge From="1" To="2" Label="Source1" />
                                  </Edges>
                                </Workflow>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Merge" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Sample" />
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="2" Label="Source1" />
                              <Edge From="1" To="2" Label="Source2" />
                              <Edge From="2" To="3" Label="Source1" />
                              <Edge From="2" To="6" Label="Source1" />
                              <Edge From="2" To="9" Label="Source1" />
                              <Edge From="3" To="4" Label="Source1" />
                              <Edge From="4" To="5" Label="Source1" />
                              <Edge From="5" To="8" Label="Source1" />
                              <Edge From="6" To="7" Label="Source1" />
                              <Edge From="7" To="8" Label="Source2" />
                              <Edge From="8" To="9" Label="Source2" />
                              <Edge From="9" To="10" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
