                          <Name>TaskParams</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:CombineLatest" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:WithLatestFrom" />
                        </Expression>
                        <Expression xsi:type="scr:ExpressionTransform">
                          <scr:Name>StimulusActive</scr:Name>
                          <scr:Description>Tone's sweep fraction, compared with the truncation point. SweepEndHz / SweepStartHz is divided as whole numbers (25000 / 2000 = 12), exactly as in 'cm to Hz', so the fraction matches how the tone actually sweeps (2-24 kHz) and equals the grating's in HideAfterTruncation. Rounded to 3 decimals in both, so CurrFreq's whole-Hz rounding cannot put the tone and grating a beep apart.</scr:Description>
                          <scr:Expression>new(it.Item1 as Buffer, (it.Item2.Item2 &gt;= 1 || Math.Round(Math.Log(Convert.ToDouble(it.Item2.Item1) / Convert.ToDouble(it.Item2.Item3.SweepStartHz)) / Math.Log(Convert.ToDouble(it.Item2.Item3.SweepEndHz / it.Item2.Item3.SweepStartHz)), 3) &lt; it.Item2.Item2 ? 1.0 : 0.0) as Gain)</scr:Expression>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Gain</Selector>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>StimulusActive</Name>
                        </Expression>
