                  <Expression xsi:type="GroupWorkflow">
                    <Name>HideAfterTruncation</Name>
                    <Description>Hides the grating past the truncation point on truncated trials (stage 6)</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>TruncationPoint</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>StartFreqV</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>EndFreqV</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:CombineLatest" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:WithLatestFrom" />
                        </Expression>
                        <Expression xsi:type="scr:ExpressionTransform">
                          <scr:Name>Opacity</scr:Name>
                          <scr:Description>Grating's sweep fraction, rounded to 3 decimals like the tone's in SilenceAfterTruncation, so both are hidden from the same position.</scr:Description>
                          <scr:Expression>it.Item2.Item1 &gt;= 1 || Math.Round(Math.Log(Convert.ToDouble(it.Item1.Item1) / Convert.ToDouble(it.Item2.Item2)) / Math.Log(Convert.ToDouble(it.Item2.Item3) / Convert.ToDouble(it.Item2.Item2)), 3) &lt; it.Item2.Item1 ? it.Item1.Item2 : 0.0</scr:Expression>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="5" Label="Source1" />
                        <Edge From="1" To="4" Label="Source1" />
                        <Edge From="2" To="4" Label="Source2" />
                        <Edge From="3" To="4" Label="Source3" />
                        <Edge From="4" To="5" Label="Source2" />
                        <Edge From="5" To="6" Label="Source1" />
                        <Edge From="6" To="7" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>LogStimulus</Name>
                    <Description>One StimulusLog row per beep while the trial is active (TrialActive = 1, so rows stop at the outcome): the beep count and position from Skip and the grating from the visual branch, zipped beep by beep, with the tone values that same beep set (CurrFreq, AudBin, StimulusActive are updated by the tone branch before the grating branch runs). Reads the tone only through those subjects, so the tone's chain is untouched. Also publishes StimulusOnsetTime, the Harp time of the trial's first row: its first tone pip and grating frame (beep 1), since Skip has already dropped beep 0, the trial's start and its laser trigger. BonsaiData_Trial's stimulusOnsetTime. Sits in series between HideAfterTruncation and GratingOpacity and passes the opacity straight through: a branch that did not lead on to the Repeat would stop the trials restarting.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source2</Name>
                        </Expression>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source3</Name>
                        </Expression>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Zip" />
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>CurrFreq</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:WithLatestFrom" />
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>AudBin</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:WithLatestFrom" />
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>StimulusActive</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:WithLatestFrom" />
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>TrialActive</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:WithLatestFrom" />
                        </Expression>
                        <Expression xsi:type="rx:Condition">
                          <Name>IsTrialActive</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="scr:ExpressionTransform">
                                <scr:Expression>it.Item2 == 1.0</scr:Expression>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1" />
                              <Edge From="1" To="2" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item1</Selector>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>HarpTime</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:WithLatestFrom" />
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>TrialNumber</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:WithLatestFrom" />
                        </Expression>
                        <Expression xsi:type="scr:ExpressionTransform">
                          <scr:Name>StimulusRow</scr:Name>
                          <scr:Expression>new(new(it.Item2 as trialNumber, it.Item1.Item1.Item1.Item1.Item1.Item1.Item2 as positionCm, it.Item1.Item1.Item1.Item1.Item2 as toneFrequencyHz, Convert.ToInt32(it.Item1.Item1.Item2) as stimulusActive, it.Item1.Item1.Item1.Item1.Item1.Item2.Item1 as visualSpatialFrequencyCpd) as Row, it.Item1.Item2 as Seconds)</scr:Expression>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>StimulusLogRow</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item2</Selector>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>StimulusOnsetTime</Name>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="3" Label="Source1" />
                        <Edge From="1" To="3" Label="Source2" />
                        <Edge From="2" To="3" Label="Source3" />
                        <Edge From="2" To="23" Label="Source1" />
                        <Edge From="3" To="5" Label="Source1" />
                        <Edge From="4" To="5" Label="Source2" />
                        <Edge From="5" To="7" Label="Source1" />
                        <Edge From="6" To="7" Label="Source2" />
                        <Edge From="7" To="9" Label="Source1" />
                        <Edge From="8" To="9" Label="Source2" />
                        <Edge From="9" To="11" Label="Source1" />
                        <Edge From="10" To="11" Label="Source2" />
                        <Edge From="11" To="12" Label="Source1" />
                        <Edge From="12" To="13" Label="Source1" />
                        <Edge From="13" To="15" Label="Source1" />
                        <Edge From="14" To="15" Label="Source2" />
                        <Edge From="15" To="17" Label="Source1" />
                        <Edge From="15" To="20" Label="Source1" />
                        <Edge From="16" To="17" Label="Source2" />
                        <Edge From="17" To="18" Label="Source1" />
                        <Edge From="18" To="19" Label="Source1" />
                        <Edge From="20" To="21" Label="Source1" />
                        <Edge From="21" To="22" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>GratingOpacity</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:CombineLatest" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:CombineLatest" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Take">
                      <rx:Count>1</rx:Count>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>Monitor</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="Value" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="StringProperty">
                            <Value>ProcessedTrialEnd</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
